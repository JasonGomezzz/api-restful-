{
  "info": {
    "_postman_id": "f16e0405-2b51-4fa0-9af8-c17b08765f05",
    "name": "Semana 05 API RESTful Tickets",
    "description": "Colección de evidencias del Laboratorio 05: correo SMTP real, tickets, paginación, errores e historial de notificaciones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Verificar conexión SMTP",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/notifications/email/status",
          "host": ["{{baseUrl}}"],
          "path": ["notifications", "email", "status"]
        },
        "description": "Comprueba conexión, TLS y autenticación sin enviar un mensaje."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('SMTP está listo', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.eql({ enabled: true, ready: true });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Crear ticket y enviar correo",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Prueba de correo real\",\n  \"description\": \"Validación SMTP del Laboratorio 05\",\n  \"priority\": \"high\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tickets",
          "host": ["{{baseUrl}}"],
          "path": ["tickets"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Ticket creado y correo aceptado', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.notification.status).to.eql('sent');",
              "  pm.expect(body.notification.messageId).to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('ticketId', body.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Asignar ticket y enviar correo",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user\": \"Jason Gómez\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}/assign",
          "host": ["{{baseUrl}}"],
          "path": ["tickets", "{{ticketId}}", "assign"]
        }
      }
    },
    {
      "name": "04 Cambiar estado del ticket",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"asignado\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["tickets", "{{ticketId}}", "status"]
        }
      }
    },
    {
      "name": "05 Listar tickets paginados",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tickets?page=1&limit=5",
          "host": ["{{baseUrl}}"],
          "path": ["tickets"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "5" }
          ]
        }
      }
    },
    {
      "name": "06 Historial de notificaciones del ticket",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}/notifications",
          "host": ["{{baseUrl}}"],
          "path": ["tickets", "{{ticketId}}", "notifications"]
        }
      }
    },
    {
      "name": "07 Listar todas las notificaciones",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/notifications",
          "host": ["{{baseUrl}}"],
          "path": ["notifications"]
        }
      }
    },
    {
      "name": "08 Probar manejo global de errores",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Ticket incompleto\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tickets",
          "host": ["{{baseUrl}}"],
          "path": ["tickets"]
        }
      }
    },
    {
      "name": "09 Eliminar ticket",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tickets", "{{ticketId}}"]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "ticketId", "value": "" }
  ]
}
